# Frontend Environment Variables
# Copy this to .env.local for local development.
# On Render, paste these values in the "Environment" section of your frontend service.

# The HTTPS URL of your deployed backend on Render.
# Example: https://researchmind-backend-xxxx.onrender.com
NEXT_PUBLIC_API_URL=http://localhost:8000

# The WSS URL of your deployed backend on Render.
# Use wss:// (secure) when deploying to production, NOT ws://
# Example: wss://researchmind-backend-xxxx.onrender.com
NEXT_PUBLIC_WS_URL=ws://localhost:8000
