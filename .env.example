# ==============================
# ResearchMind AI — Vaani
# Environment Variables Template
# Copy this to .env and fill in your keys.
# NEVER commit .env to git.
# ==============================

# LLM Provider: groq | gemini | ollama | mock
# Use 'groq' for real AI responses (fast, free tier — recommended).
# Use 'gemini' for Google Gemini Flash models.
# Use 'mock' to test the pipeline without any API key.
LLM_PROVIDER=groq

# Groq Configuration
# Get API key at: https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Gemini Configuration
# Get API key at: https://aistudio.google.com
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Ollama (fully offline, zero cost)
# Start Ollama with: ollama run llama3.1:8b
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# Database Configuration (SQLite default; Postgres supported)
DATABASE_URL=sqlite:///./researchmind.db

# Edge / Voice / TTS Settings
ELEVENLABS_API_KEY=

# Security & CORS settings
SECRET_KEY=researchmind_secret
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# App settings
APP_ENV=development
APP_PORT=8000
