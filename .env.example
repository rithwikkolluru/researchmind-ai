# ==============================
# ResearchMind AI — Vaani
# Environment Variables Template
# Copy this to .env and fill in your keys.
# NEVER commit .env to git.
# ==============================

# LLM Provider: groq | gemini | ollama | mock
# Use 'groq' for real AI responses (fast, free tier — recommended).
# Use 'mock' to test the voice pipeline without any API key.
LLM_PROVIDER=groq

# Groq API Key (free tier — fast Llama 3.3 70B)
# Get one at: https://console.groq.com
GROQ_API_KEY=

# Gemini API Key (free tier — good for document-heavy sessions)
# Get one at: https://aistudio.google.com
GEMINI_API_KEY=

# Ollama (fully offline, zero cost)
# Start Ollama with: ollama run llama3.1:8b
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# ElevenLabs (optional — demo only, 10k chars/month free tier)
ELEVENLABS_API_KEY=

# App settings
APP_ENV=development
APP_PORT=8000
